    productLogo:         "white.png"
    productWelcome:      "nixos-logomark-default-flat-none.svg"

style:
   SidebarBackground:        "#1C1917"
   SidebarText:              "#C8C4BE"
   SidebarTextCurrent:       "#E8E5DF"
   SidebarBackgroundCurrent: "#332F2C"

slideshow:               "show.qml"
slideshowAPI: 2

uploadServer:
    type: none
    url:
