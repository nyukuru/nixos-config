windowExpanding: normal
windowSize: 1000px,700px
windowPlacement: center

sidebar: widget
navigation: widget

strings:
    productName:         carbon
    shortProductName:    carbon
    version:
    shortVersion:
    versionedName:       carbon
    shortVersionedName:  carbon
    bootloaderEntryName: NyuOS
